[Unit]
Description=Phoenix PaaS Control Panel
After=network.target

[Service]
Type=exec
User=root
Group=root
WorkingDirectory=/opt/phoenix_paas/current
EnvironmentFile=/etc/phoenix_paas/env
ExecStart=/opt/phoenix_paas/current/bin/server
Restart=always
RestartSec=5
MemoryMax=768M
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target