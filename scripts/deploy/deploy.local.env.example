# Copy to deploy.local.env and fill in values (never commit deploy.local.env).

# Panel Lightsail instance
DEPLOY_IP=
DEPLOY_HOST=paas.gestaobem.com
DEPLOY_SSH_KEY=$HOME/.ssh/lightsail-default-key-us-east-1.pem
DEPLOY_USER=ubuntu
CADDY_EMAIL=admin@gestaobem.com

# Path to production env file for bootstrap (copy from deploy/env.production.example)
ENV_FILE=deploy/env.production

# Set true on first deploy to seed owner + Trip Planner app
RUN_SEED=false